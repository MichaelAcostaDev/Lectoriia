# Create a fine-grained Hugging Face token with Inference Providers permission.
HUGGINGFACE_API_TOKEN=
HF_CHAT_MODEL=Qwen/Qwen2.5-7B-Instruct-1M

# Local Flask server
PORT=5000
FLASK_DEBUG=false

# Optional AdSense configuration. Leave blank until your site is approved.
ADSENSE_PUBLISHER_ID=
ADSENSE_AUTO_ADS=false
ADSENSE_SLOT_HERO=
ADSENSE_SLOT_MIDDLE=
ADSENSE_SLOT_SIDEBAR=
ADSENSE_SLOT_FOOTER=

# Optional privacy-policy contact; no address is displayed unless configured.
PRIVACY_CONTACT_EMAIL=
